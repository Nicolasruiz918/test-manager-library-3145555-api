{
  "name": "manager-library/api",
  "type": "project",
  "description": "Manager Library API, implemented from the React/Laravel specification.",
  "license": "proprietary",
  "require": {
    "php": "^8.5",
    "firebase/php-jwt": "^7.2",
    "laravel/framework": "^13.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {"psr-4": {"App\\": "app/"}},
  "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
  "config": {"sort-packages": true, "optimize-autoloader": true},
  "scripts": {"test": "phpunit", "test:health": "phpunit --testsuite Feature"}
}
